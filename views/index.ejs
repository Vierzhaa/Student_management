<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <style>
        :root {
    --bg:           #f3f0fa;
    --card:         #ffffff;
    --primary:      #7c3aed;
    --primary-dark: #4c1d95;
    --primary-50:   #ede9fe;
    --primary-100:  #ddd6fe;
    --accent:       #f472b6;
    --text:         #1a1a1a;
    --text-muted:   #6b7280;
    --border:       #e0d7f5;
}

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: var(--bg);
            font-family: 'Sora', sans-serif;
            color: var(--text);
            min-height: 100vh;
        }

        /* ── PAGE HEADER ── */
        .page-header {
            background: var(--primary-dark);
            padding: 2.8rem 0 4rem;
            margin-bottom: -2rem;
            position: relative;
            overflow: hidden;
        }

        .page-header::before {
            content: '';
            position: absolute;
            top: -60px; right: -60px;
            width: 260px; height: 260px;
            border-radius: 50%;
            background: rgba(255,255,255,0.04);
        }

        .page-header::after {
            content: '';
            position: absolute;
            bottom: -80px; left: 40%;
            width: 340px; height: 340px;
            border-radius: 50%;
            background: rgba(255,255,255,0.03);
        }

        .header-inner {
            max-width: 880px;
            margin: 0 auto;
            padding: 0 1.5rem;
            position: relative;
            z-index: 1;
        }

        .header-eyebrow {
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--primary-100);
            margin-bottom: 0.6rem;
        }

        .page-header h1 {
            font-size: 2.1rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.025em;
            line-height: 1.15;
        }

        .header-sub {
            margin-top: 0.4rem;
            font-size: 0.85rem;
            color: rgba(255,255,255,0.5);
            font-weight: 300;
        }

        /* ── MAIN WRAP ── */
        .main-wrap {
            max-width: 880px;
            margin: 0 auto;
            padding: 2rem 1.5rem 5rem;
        }

        /* ── CARD ── */
        .card-panel {
            background: var(--card);
            border-radius: var(--r);
            border: 1px solid var(--border);
            overflow: hidden;
            margin-bottom: 1.5rem;
        }

        .card-top {
            padding: 1.1rem 1.5rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #fcfaf8;
        }

        .card-top h2 {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--text);
        }

        .pill {
            font-size: 0.7rem;
            font-weight: 600;
            padding: 0.22rem 0.7rem;
            border-radius: 999px;
            background: var(--primary-50);
            color: var(--primary-dark);
        }

        /* ── TABLE ── */
        .data-table {
            width: 100%;
            border-collapse: collapse;
        }

        .data-table thead th {
            padding: 0.85rem 1.5rem;
            font-size: 0.68rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-muted);
            text-align: left;
            background: #fafaf8;
            border-bottom: 1px solid var(--border);
        }

        .data-table tbody tr {
            transition: background 0.12s ease;
        }

        .data-table tbody tr:hover {
            background: #fbf9f6;
        }

        .data-table tbody td {
            padding: 0.9rem 1.5rem;
            font-size: 0.875rem;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }

        .data-table tbody tr:last-child td {
            border-bottom: none;
        }

        .id-chip {
            display: inline-block;
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 0.15rem 0.55rem;
            font-family: 'Courier New', monospace;
            font-size: 0.78rem;
            font-weight: 700;
            color: var(--text-muted);
            letter-spacing: 0.04em;
        }

        .nama-text {
            font-weight: 500;
            color: var(--text);
        }

        .kelas-chip {
            display: inline-block;
            background: var(--primary-50);
            color: var(--primary-dark);
            border-radius: 6px;
            padding: 0.18rem 0.65rem;
            font-size: 0.78rem;
            font-weight: 600;
        }

        /* ── EMPTY STATE ── */
        .empty-row td {
            text-align: center;
            padding: 3rem 1.5rem !important;
            color: var(--text-muted);
            font-size: 0.875rem;
        }

        .empty-icon {
            font-size: 2rem;
            display: block;
            margin-bottom: 0.5rem;
        }

        /* ── FORM ── */
        .form-body {
            padding: 1.5rem;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-bottom: 1.25rem;
        }

        .field label {
            display: block;
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.09em;
            color: var(--text-muted);
            margin-bottom: 0.45rem;
        }

        .field input {
            width: 100%;
            padding: 0.68rem 0.95rem;
            background: #fafaf8;
            border: 1.5px solid var(--border);
            border-radius: 8px;
            font-family: 'Sora', sans-serif;
            font-size: 0.875rem;
            color: var(--text);
            outline: none;
            transition: border-color 0.18s, box-shadow 0.18s, background 0.18s;
        }

        .field input::placeholder {
            color: #b9b0a8;
        }

        .field input:focus {
            border-color: var(--primary);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(45, 106, 79, 0.1);
        }

        .form-footer {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: var(--primary);
            color: #fff;
            border: none;
            padding: 0.7rem 1.6rem;
            border-radius: 8px;
            font-family: 'Sora', sans-serif;
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.18s, transform 0.1s, box-shadow 0.18s;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            box-shadow: 0 4px 14px rgba(27, 67, 50, 0.25);
        }

        .btn-primary:active {
            transform: scale(0.97);
        }

        .btn-primary svg {
            width: 16px; height: 16px;
            stroke: currentColor;
            stroke-width: 2;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            flex-shrink: 0;
        }

        .form-hint {
            font-size: 0.78rem;
            color: var(--text-muted);
        }

        /* ── RESPONSIVE ── */
        @media (max-width: 580px) {
            .page-header { padding: 2rem 0 3.5rem; }
            .page-header h1 { font-size: 1.6rem; }
            .form-row { grid-template-columns: 1fr; }
            .data-table thead th,
            .data-table tbody td { padding-left: 1rem; padding-right: 1rem; }
        }
    </style>
</head>
<body>

    <header class="page-header">
        <div class="header-inner">
            <p class="header-eyebrow">Management System</p>
            <h1><%= title %></h1>
            <p class="header-sub">Manage student data easily &amp; quickly</p>
        </div>
    </header>

    <div class="main-wrap">

        <div class="card-panel">
            <div class="card-top">
                <h2>Student List</h2>
                <span class="pill"><%= users.length %> registered students</span>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Name</th>
                        <th style="width: 140px;">Class</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (users.length === 0) { %>
                    <tr class="empty-row">
                        <td colspan="3">
                            <span class="empty-icon">📋</span>
                            No student data yet. Add below!
                        </td>
                    </tr>
                    <% } else { %>
                    <% for (let user of users) { %>
                    <tr>
                        <td><span class="id-chip">#<%= user.id %></span></td>
                        <td><span class="nama-text"><%= user.nama %></span></td>
                        <td><span class="kelas-chip"><%= user.kelas %></span></td>
                    </tr>
                    <% } %>
                    <% } %>
                </tbody>
            </table>
        </div>

        <div class="card-panel">
            <div class="card-top">
                <h2>Add New Student</h2>
            </div>
            <div class="form-body">
                <form action="/tambah" method="post">
                    <div class="form-row">
                        <div class="field">
                            <label for="nama">Name</label>
                            <input
                                type="text"
                                id="nama"
                                name="nama"
                                placeholder="Student's full name..."
                                autocomplete="off"
                                required
                            >
                        </div>
                        <div class="field">
                            <label for="kelas">Class</label>
                            <input
                                type="text"
                                id="kelas"
                                name="kelas"
                                placeholder="Example: 10-A, 11-B..."
                                autocomplete="off"
                                required
                            >
                        </div>
                    </div>
                    <div class="form-footer">
                        <button type="submit" class="btn-primary">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            Add Student
                        </button>
                        <span class="form-hint">All fields are required.</span>
                    </div>
                </form>
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>